{
  "name": "irawan19-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio site (static). Includes a Jest test suite for the first-party JavaScript modules.",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "istanbul-lib-instrument": "6.0.3",
    "jest": "29.7.0",
    "jest-canvas-mock": "2.5.2",
    "jest-environment-jsdom": "29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "pretendToBeVisual": true
    },
    "setupFiles": [
      "jest-canvas-mock"
    ],
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "assets/js/**/*.js"
    ],
    "coverageDirectory": "coverage"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
